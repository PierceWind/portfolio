---
const base = import.meta.env.BASE_URL;

const skills = [
  'PHP / JavaScript / Python',
  'MySQL and database workflows',
  'MVC and layered architecture',
  'Authentication and RBAC',
  'APIs and service integrations',
  'IT operations and support',
];

const projects = [
  {
    number: '01',
    title: 'AIMS · Aleson Integrated Management System',
    type: 'Business-oriented web platform · Aug 2024 – Aug 2026',
    description: 'Conceptualized and developed a modular PHP/MySQL platform spanning employee, authentication, ticketing, cargo, POS/inventory, reporting, administration, and passenger-service workflows.',
    tags: ['PHP / MySQL', 'Full-stack delivery', 'Production support'],
    links: [
      { label: 'Project preview', href: `${base}work/aims` },
      { label: 'Open AIMS', href: 'https://alesonshippinglines.com/jerusa', external: true },
    ],
    featured: true,
  },
  {
    number: '02',
    title: 'BPMN · Business Process Modeling',
    type: 'College project · Process analysis',
    description: 'A college project focused on documenting, analyzing, and communicating business processes through Business Process Model and Notation diagrams.',
    tags: ['BPMN', 'Process design', 'Documentation'],
    links: [{ label: 'View project files', href: 'https://drive.google.com/drive/folders/1IN7Gl6lCNlnJMS6GJv37FbAxFQ-X-N6S?usp=drive_link', external: true }],
  },
  {
    number: '03',
    title: 'Layout / Graphic Design',
    type: 'College project · Visual communication',
    description: 'A collection of layout and graphic design work created for academic projects, visual communication, and presentation needs.',
    tags: ['Graphic design', 'Layout', 'Visual communication'],
    links: [{ label: 'View project files', href: 'https://drive.google.com/drive/folders/1XB_SwhoPL_zWqkEKF3HTiRXl8yrXrn1m?usp=drive_link', external: true }],
  },
  {
    number: '04',
    title: 'DMBS · Database Management System',
    type: 'College project · Data and systems',
    description: 'A database-focused academic project covering structured data, relationships, workflows, and the practical organization of information systems.',
    tags: ['Database design', 'Data modeling', 'Systems analysis'],
    links: [{ label: 'View project files', href: 'https://drive.google.com/drive/folders/1YwHdvsEPLgg6u2c04vqxcxtVu144k0Cw?usp=drive_link', external: true }],
  },
  {
    number: '05',
    title: 'Data Communications & Networking',
    type: 'College project · Network fundamentals',
    description: 'An academic project exploring data communication concepts, networking foundations, connectivity, and how systems exchange information.',
    tags: ['Networking', 'Data communications', 'Infrastructure'],
    links: [{ label: 'View project files', href: 'https://drive.google.com/drive/folders/1Hvlv-hCLbkKhPyjws4eMbU-ozFyb9V3a?usp=drive_link', external: true }],
  },
  {
    number: '06',
    title: 'Wokwi Arduino Projects',
    type: 'College project · Interactive hardware prototypes',
    description: 'Arduino experiments and interactive hardware prototypes developed and simulated with Wokwi.',
    tags: ['Arduino', 'Wokwi', 'Prototyping'],
    links: [{ label: 'View Wokwi profile', href: 'https://wokwi.com/makers/piercewind', external: true }],
  },
];

const experience = [
  {
    period: 'Aug 2024 – Aug 2026',
    role: 'Personal Technical Assistant / Full Stack Web/System Developer',
    company: 'Office of Alexander A. Tan · Aleson Shipping Lines, Inc.',
    detail: 'Built and supported AIMS, reusable business services, authentication and access-control workflows, API integrations, reporting tools, and production systems.',
  },
  {
    period: 'Jan 2024 – May 2024',
    role: 'IT Operations Technical Support Intern',
    company: 'Concentrix · Alabang 2 & 3 Site',
    detail: 'Supported endpoint maintenance, Active Directory, asset inventory, reimaging, hardware upgrades, security patching, network troubleshooting, and technical ticket documentation.',
  },
  {
    period: '~2 months',
    role: 'Sales Reconciliation Assistant / Sales Data Analysis',
    company: 'Cat Sales of Carica Herbal Health Products, Inc.',
    detail: 'Reconciled daily product-level sales across 112 branches using mall portal reports, Excel, and PivotTables; validated quantities and totals, and completed five outstanding sales reports.',
  },
  {
    period: '~3 years',
    role: 'Freelance / All Around Tech & Creative Support',
    company: 'TDF Foods & Carica Herbal Health, Inc.',
    detail: 'Handled social media, content creation, graphic design, photography, advertising support, layouts, and book editing.',
  },
];

const certifications = [
  { title: 'Programming for Beginners Using Python', issuer: 'DICT · June 26, 2024', image: `${base}certifications/dict-python.png` },
  { title: 'Introduction to Computer Systems Servicing', issuer: 'TESDA · August 6, 2026', image: `${base}certifications/tesda-computer-systems-servicing.png` },
  { title: 'Introduction to Critical Infrastructure Protection', issuer: 'OPSWAT Academy · January 16, 2025', image: `${base}certifications/opswat-critical-infrastructure-protection.png` },
  { title: '20-Day Nanay-Tatay Sessions of Tara, BASA! Tutoring Program', issuer: 'DSWD / DepEd · December 18, 2023', image: `${base}certifications/dswd-nanay-tatay-tara-basa.png` },
  { title: 'Hacktoberfest 2022 Virtual Seminar', issuer: 'League of Innovative Programmers · October 28, 2022', image: `${base}certifications/hacktoberfest-2022.png` },
  { title: '500-Hour On-the-Job Training · IT Operations', issuer: 'Concentrix Philippines · May 22, 2024', image: `${base}certifications/concentrix-ojt-completion.jpg` },
  { title: 'Honor Graduate Eligibility', issuer: 'Civil Service Commission · March 24, 2026', image: `${base}certifications/csc-honor-graduate-eligibility.jpg` },
  { title: 'Bachelor of Science in Information Systems · Magna Cum Laude', issuer: 'DFCAMCLP – IT Campus · July 26, 2024', image: `${base}certifications/bsis-magna-cum-laude-diploma.jpg` },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="description" content="Portfolio of Jerusa Mae P. Abalos — Full Stack Web and System Developer building practical business platforms." />
    <meta name="theme-color" content="#f7f8fb" />
    <title>Jerusa Mae P. Abalos · Full Stack Web / System Developer</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Jerusa Mae Abalos home">PIERCEWIND<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a href="#experience">Experience</a>
        <a href="#skills">Skills</a>
        <a href="#certifications">Certifications</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="header-link" href="#contact">Let's talk <span aria-hidden="true">↗</span></a>
    </header>

    <main id="top">
      <section class="hero container">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> Full Stack Web / System Developer</p>
          <h1>I build digital<br /><em>systems that work.</em></h1>
          <p class="hero-intro">I'm Jerusa Mae P. Abalos, an Information Systems graduate and Magna Cum Laude developer who turns operational requirements into practical, dependable web and business systems.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↘</span></a>
            <a class="text-link" href={`${base}Jerusa-Mae-Abalos_CV2026_v2.pdf`} download>Download my CV <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hero-note" aria-label="Introduction note">
          <span class="note-mark">✳</span>
          <p>From first idea<br />to owner handoff.</p>
          <span class="note-line"></span>
          <small>01 / 04</small>
        </div>
      </section>

      <div class="ticker" aria-label="Areas of focus">
        <div class="ticker-track"><span>FULL-STACK DEVELOPMENT</span><b>✳</b><span>BUSINESS SYSTEMS</span><b>✳</b><span>IT OPERATIONS</span><b>✳</b><span>FULL-STACK DEVELOPMENT</span><b>✳</b><span>BUSINESS SYSTEMS</span></div>
      </div>

      <section id="about" class="section container about-grid">
        <div class="section-label"><span>01</span><span>About me</span></div>
        <div class="about-content">
          <h2>Practical technology.<br /><em>Human results.</em></h2>
          <p class="large-copy">I'm an Information Systems graduate and Magna Cum Laude with two years of professional experience across full-stack development, IT operations, technical support, and business process support.</p>
          <p>I specialize in turning real operational needs into maintainable systems. My work spans application architecture, backend services, databases, authentication, APIs, reporting, endpoint support, and production handover—with a practical, iterative approach to solving problems.</p>
          <div class="about-facts"><div><strong>01</strong><span>BS Information Systems</span></div><div><strong>02</strong><span>Magna Cum Laude</span></div><div><strong>03</strong><span>CSC Honor Graduate</span></div></div>
        </div>
      </section>

      <section id="work" class="section section-tint">
        <div class="container">
          <div class="section-heading"><div class="section-label"><span>02</span><span>Selected work</span></div><p>Projects shaped around real-world needs.</p></div>
          <div class="project-list">
            {projects.map((project) => (
              <article class:list={['project-card', { featured: project.featured }]}>
                <div class="project-number">{project.number}</div>
                <div class="project-info"><p class="project-type">{project.type}</p><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div><div class="project-links">{project.links.map((link) => <a class="project-link" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>{link.label}<span aria-hidden="true">↗</span></a>)}</div></div>
                <span class="project-arrow" aria-hidden="true">↗</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="experience" class="section container experience-section">
        <div class="section-heading"><div class="section-label"><span>03</span><span>Experience</span></div><p>Technology grounded in real operations.</p></div>
        <div class="experience-list">
          {experience.map((item) => (
            <article class="experience-item">
              <p class="experience-period">{item.period}</p>
              <div><h3>{item.role}</h3><p class="experience-company">{item.company}</p><p class="experience-detail">{item.detail}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section id="skills" class="section container skills-grid">
        <div class="section-label"><span>04</span><span>What I do</span></div>
        <div><h2>Useful skills for<br /><em>complex problems.</em></h2><div class="skill-list">{skills.map((skill, index) => <div><span>0{index + 1}</span><strong>{skill}</strong><i>↗</i></div>)}</div><div class="credentials"><p class="eyebrow">Education & credentials</p><p><strong>BS Information Systems</strong><br />Dr. Filemon C. Aguilar Memorial College of Las Piñas – IT Campus · 2020–2024 · Magna Cum Laude</p><p><strong>Certifications</strong><br />CSC Honor Graduate Eligibility · TESDA Introduction to Computer Systems Servicing · OPSWAT Introduction to Critical Infrastructure Protection · DICT Basic Programming Using Python</p><a class="text-link" href={`${base}Jerusa-Mae-Abalos_CV2026_v2.pdf`} download>Download the full CV <span aria-hidden="true">↓</span></a></div></div>
      </section>

      <section id="certifications" class="section section-tint certifications-section">
        <div class="container">
          <div class="section-heading"><div class="section-label"><span>05</span><span>Certifications</span></div><p>Credentials earned through continued learning.</p></div>
          <div class="certification-grid">
            {certifications.map((certification) => (
              <article class="certification-card">
                <a href={certification.image} target="_blank" rel="noreferrer"><img src={certification.image} alt={`${certification.title} certificate`} loading="lazy" /></a>
                <div><p class="certification-issuer">{certification.issuer}</p><h3>{certification.title}</h3><a class="text-link" href={certification.image} target="_blank" rel="noreferrer">View certificate <span aria-hidden="true">↗</span></a></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="contact" class="contact-section">
        <div class="container contact-inner"><p class="eyebrow">Have a project in mind?</p><h2>Let's make something<br /><em>worth using.</em></h2><a class="button button-light" href="mailto:jerusamae.abalos027@gmail.com">Start a conversation <span aria-hidden="true">↗</span></a><p class="contact-note">jerusamae.abalos027@gmail.com · +63 969 174 3159</p></div>
      </section>
    </main>

    <footer class="site-footer container"><span>© {new Date().getFullYear()} Jerusa Mae Abalos</span><span>Built with care · GitHub Pages</span><a href="#top">Back to top ↑</a></footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;1,500;1,600&display=swap');
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; color: #18201e; background: #f7f8fb; font-family: 'DM Sans', sans-serif; }
  :global(a) { color: inherit; text-decoration: none; }
  .container { width: min(1120px, calc(100% - 64px)); margin: 0 auto; }
  .site-header { width: min(1120px, calc(100% - 64px)); height: 88px; margin: auto; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #dfe4e3; }
  .brand { font-size: 1.15rem; font-weight: 700; letter-spacing: .12em; }.brand span { color: #e66b4d; }
  nav { display: flex; gap: 32px; color: #6f7977; font-size: .82rem; } nav a:hover, .header-link:hover { color: #e66b4d; }
  .header-link { color: #384340; font-size: .82rem; font-weight: 600; }.header-link span { margin-left: 8px; color: #e66b4d; }
  .hero { min-height: 680px; display: flex; align-items: center; justify-content: space-between; padding: 110px 0 125px; }.hero-copy { max-width: 720px; }.eyebrow, .section-label, .project-type, .note-line + small { font-family: 'DM Mono', monospace; text-transform: uppercase; letter-spacing: .12em; font-size: .68rem; }.eyebrow { display: flex; align-items: center; gap: 9px; color: #6f7977; }.status-dot { width: 7px; height: 7px; display: inline-block; border-radius: 100%; background: #e66b4d; box-shadow: 0 0 0 5px #fbe8e1; }
  h1, h2, h3, p { margin-top: 0; } h1 { margin: 27px 0; font-size: clamp(3.8rem, 8vw, 7.4rem); line-height: .95; letter-spacing: -.07em; font-weight: 600; } h1 em, h2 em { color: #e66b4d; font-family: 'Playfair Display', serif; font-weight: 500; letter-spacing: -.04em; } h2 { font-size: clamp(2.5rem, 5vw, 4.3rem); line-height: 1.02; letter-spacing: -.06em; font-weight: 600; } h3 { font-size: clamp(1.5rem, 2.7vw, 2.25rem); line-height: 1.05; letter-spacing: -.04em; }
  .hero-intro { width: min(470px, 100%); color: #697471; font-size: 1.05rem; line-height: 1.7; }.hero-actions { display: flex; align-items: center; gap: 28px; margin-top: 38px; }.button { display: inline-flex; align-items: center; gap: 20px; padding: 15px 20px; border: 1px solid transparent; font-size: .78rem; font-weight: 700; }.button-primary { color: #fff; background: #1c2825; }.button-primary:hover { background: #e66b4d; }.button-light { color: #18201e; background: #f7f8fb; }.button-light:hover { background: #e66b4d; color: white; }.text-link { color: #697471; font-size: .8rem; }.text-link span { margin-left: 9px; color: #e66b4d; }.hero-note { width: 150px; margin-right: 6%; color: #8d9793; transform: rotate(-8deg); }.note-mark { color: #e66b4d; font-size: 3rem; }.hero-note p { margin: 13px 0; font-family: 'Playfair Display', serif; font-size: 1.2rem; line-height: 1.2; }.note-line { display: block; width: 80px; border-top: 1px solid #bbc4c1; }.hero-note small { display: block; margin-top: 12px; }
  .ticker { overflow: hidden; color: #f7f8fb; background: #1c2825; }.ticker-track { display: flex; align-items: center; justify-content: space-around; min-width: 1050px; padding: 21px 0; font-family: 'DM Mono', monospace; font-size: .65rem; letter-spacing: .16em; }.ticker b { color: #e66b4d; font-size: 1rem; }
  .section { padding: 145px 0; }.about-grid, .skills-grid { display: grid; grid-template-columns: 180px 1fr; gap: 90px; }.section-label { display: flex; gap: 20px; color: #88928e; }.section-label span:first-child { color: #e66b4d; }.about-content { max-width: 700px; }.about-content h2, .skills-grid h2 { margin-top: 0; }.large-copy { color: #3e4c48; font-size: 1.27rem; line-height: 1.65; }.about-content > p:not(.large-copy) { max-width: 590px; color: #7a8581; font-size: .95rem; line-height: 1.8; }.about-facts { display: flex; gap: 48px; margin-top: 60px; padding-top: 24px; border-top: 1px solid #dfe4e3; }.about-facts div { display: flex; flex-direction: column; gap: 10px; }.about-facts strong { color: #e66b4d; font-family: 'DM Mono', monospace; font-size: .7rem; }.about-facts span { color: #5c6864; font-size: .78rem; }
  .section-tint { background: #eef2f0; }.section-heading { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 66px; }.section-heading > p { color: #7b8582; font-size: .9rem; }.project-list { border-top: 1px solid #cdd6d2; }.project-card { display: grid; grid-template-columns: 90px 1fr 50px; gap: 20px; align-items: start; padding: 42px 0; border-bottom: 1px solid #cdd6d2; }.project-number, .project-type { color: #e66b4d; font-family: 'DM Mono', monospace; font-size: .7rem; }.project-info h3 { max-width: 600px; margin: 10px 0 18px; }.project-info > p:not(.project-type) { max-width: 650px; color: #687570; font-size: .92rem; line-height: 1.7; }.tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }.tags span { padding: 7px 10px; border: 1px solid #cad4d0; color: #687570; font-family: 'DM Mono', monospace; font-size: .61rem; }.project-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }.project-link { display: inline-flex; align-items: center; gap: 12px; padding: 10px 13px; border: 1px solid #bdc9c4; color: #384340; font-size: .72rem; font-weight: 600; }.project-link span { color: #e66b4d; }.project-link:hover { border-color: #e66b4d; color: #e66b4d; }.project-arrow { justify-self: end; color: #e66b4d; font-size: 1.6rem; }.project-card:hover h3 { color: #e66b4d; }.project-card.featured { padding-top: 50px; }
  .skill-list { margin-top: 50px; border-top: 1px solid #dfe4e3; }.skill-list div { display: grid; grid-template-columns: 55px 1fr 25px; gap: 20px; align-items: center; padding: 19px 0; border-bottom: 1px solid #dfe4e3; }.skill-list span { color: #e66b4d; font-family: 'DM Mono', monospace; font-size: .65rem; }.skill-list strong { font-size: .95rem; font-weight: 500; }.skill-list i { color: #9aa49f; font-style: normal; }
  .experience-section { padding-top: 0; }.experience-list { border-top: 1px solid #dfe4e3; }.experience-item { display: grid; grid-template-columns: 220px 1fr; gap: 35px; padding: 34px 0; border-bottom: 1px solid #dfe4e3; }.experience-period { color: #e66b4d; font-family: 'DM Mono', monospace; font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; }.experience-item h3 { margin-bottom: 10px; }.experience-company { color: #3e4c48; font-size: .9rem; font-weight: 600; }.experience-detail { max-width: 650px; margin-bottom: 0; color: #7a8581; font-size: .9rem; line-height: 1.7; }.credentials { margin-top: 55px; padding-top: 28px; border-top: 1px solid #dfe4e3; }.credentials .eyebrow { margin-bottom: 22px; }.credentials p:not(.eyebrow) { max-width: 650px; color: #7a8581; font-size: .86rem; line-height: 1.7; }.credentials strong { color: #3e4c48; }.certifications-section { padding-top: 110px; }.certification-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }.certification-card { min-width: 0; }.certification-card > a { display: block; overflow: hidden; background: #fff; border: 1px solid #dfe4e3; }.certification-card img { display: block; width: 100%; aspect-ratio: 1.42; object-fit: cover; transition: transform .3s ease; }.certification-card > a:hover img { transform: scale(1.03); }.certification-card h3 { margin: 8px 0 14px; font-size: 1.25rem; }.certification-issuer { margin: 22px 0 0; color: #e66b4d; font-family: 'DM Mono', monospace; font-size: .65rem; text-transform: uppercase; letter-spacing: .08em; }
  .contact-section { color: #f7f8fb; background: #1c2825; }.contact-inner { padding: 125px 0; }.contact-inner h2 { margin: 22px 0 40px; }.contact-inner .eyebrow { color: #aebbb5; }.contact-inner h2 em { color: #e66b4d; }.contact-note { display: inline-block; margin-left: 20px; color: #8b9892; font-size: .72rem; }.site-footer { display: flex; justify-content: space-between; gap: 20px; padding: 28px 0; color: #8b9692; font-family: 'DM Mono', monospace; font-size: .62rem; text-transform: uppercase; letter-spacing: .06em; }
  @media (max-width: 720px) { .container, .site-header { width: min(100% - 40px, 1120px); }.site-header { height: 70px; }.site-header nav { display: none; }.header-link { font-size: .7rem; }.hero { min-height: 0; padding: 90px 0 100px; }.hero-note { display: none; } h1 { font-size: clamp(3.4rem, 16vw, 5.5rem); }.hero-actions { align-items: flex-start; flex-direction: column; gap: 23px; }.section { padding: 90px 0; }.about-grid, .skills-grid { display: block; }.section-label { margin-bottom: 55px; }.about-content h2, .skills-grid h2 { margin-bottom: 35px; }.about-facts { flex-direction: column; gap: 20px; }.experience-item { display: block; }.experience-period { margin-bottom: 18px; }.certification-grid { grid-template-columns: 1fr; }.section-heading { display: block; margin-bottom: 42px; }.section-heading > p { margin-top: 25px; }.project-card { grid-template-columns: 45px 1fr 20px; gap: 10px; padding: 32px 0; }.project-info h3 { font-size: 1.5rem; }.project-arrow { font-size: 1.2rem; }.contact-inner { padding: 90px 0; }.contact-note { display: block; margin: 18px 0 0; line-height: 1.6; }.site-footer { align-items: flex-start; flex-direction: column; line-height: 1.6; } }
</style>
