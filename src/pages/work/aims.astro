---
const base = import.meta.env.BASE_URL;

const subsystems = [
  'Employee Dashboard',
  'Employee Profile',
  'Login Activity Monitor',
  'Access Control Monitor',
  'Attendance Monitoring System',
  'Online Ticket Booking System',
  'Ticket POS',
  'Boarding System',
  'Activity & Travel History',
  'Ticketing Reports',
  'Cargo System',
  'Canteen System',
  'Internal System',
  'Management System',
  'Public Utilities',
  'Diagnostic Module',
  'Global Services',
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="AIMS case study — a modular PHP/MySQL platform built for shipping, business operations, and passenger services." />
    <meta name="theme-color" content="#f7f8fb" />
    <title>AIMS · Aleson Integrated Management System | Jerusa Mae P. Abalos</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}`} aria-label="Jerusa Mae Abalos home">PIERCEWIND<span>.</span></a>
      <a class="back-link" href={`${base}#work`}>← Back to selected work</a>
      <a class="header-link" href="mailto:jerusamae.abalos027@gmail.com">Let's talk <span aria-hidden="true">↗</span></a>
    </header>

    <main>
      <section class="project-hero container">
        <p class="eyebrow"><span class="status-dot"></span> Selected project · 01</p>
        <h1>AIMS · Aleson<br /><em>Integrated Management System.</em></h1>
        <p class="hero-intro">A web-based, modular monolithic platform that unifies operational, management, administrative, and passenger service workflows for Aleson Shipping Lines, Inc. and the personal office of Mr. Alexander A. Tan.</p>
        <div class="project-meta">
          <div><span>Role</span><strong>Full Stack Web / System Developer</strong></div>
          <div><span>Timeline</span><strong>Aug 2024 – Aug 2026</strong></div>
          <div><span>Foundation</span><strong>PHP 8.2 · MySQL</strong></div>
        </div>
      </section>

      <section class="preview-section">
        <div class="container">
          <div class="preview-frame"><img src={`${base}projects/aims-homepage.png`} alt="AIMS passenger booking homepage preview" /></div>
          <p class="image-caption">AIMS passenger service homepage — bringing trip search, ticketing, account access, and rewards into one unified experience.</p>
        </div>
      </section>

      <section class="section container overview-grid">
        <div class="section-label"><span>01</span><span>Overview</span></div>
        <div class="overview-content">
          <h2>One platform for<br /><em>complex operations.</em></h2>
          <p class="large-copy">AIMS was designed to consolidate diverse services into a single deployable custom framework. Instead of separating employee tools, shipping workflows, management functions, and public services across disconnected systems, it gives each area a shared foundation for identity, routing, data, and auditability.</p>
          <p>Internally, each module follows a layered architecture—presentation, application, domain, and infrastructure—and applies the MVC pattern for request handling. Business logic is encapsulated in reusable service classes, allowing workflows and security rules to remain consistent as the platform grows.</p>
        </div>
      </section>

      <section class="section section-tint">
        <div class="container architecture-grid">
          <div class="section-label"><span>02</span><span>What I built</span></div>
          <div>
            <h2>From architecture<br /><em>to production support.</em></h2>
            <div class="capability-list">
              <article><strong>01</strong><div><h3>Application architecture</h3><p>Designed subsystem-based routing, MVC request handling, layered application structure, reusable service classes, database workflows, and audit-oriented logging.</p></div></article>
              <article><strong>02</strong><div><h3>Security and identity</h3><p>Implemented shared authentication layers, session management, role-based access control, push MFA, login monitoring, notifications, reminders, and document verification workflows.</p></div></article>
              <article><strong>03</strong><div><h3>Integrations and services</h3><p>Built and supported integrations with Google OAuth, reCAPTCHA, Gmail API, Firebase FCM, Facebook Sign-In/API, PHPMailer, and HTTP APIs.</p></div></article>
              <article><strong>04</strong><div><h3>Operations and handover</h3><p>Handled troubleshooting, database work, production and hosting support, file-transfer workflows, technical documentation, and final technical handover.</p></div></article>
            </div>
          </div>
        </div>
      </section>

      <section class="section container subsystem-section">
        <div class="section-heading"><div class="section-label"><span>03</span><span>Core subsystems</span></div><p>17 connected areas across the platform.</p></div>
        <div class="subsystem-grid">
          {subsystems.map((subsystem, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{subsystem}</strong></div>)}
        </div>
      </section>

      <section class="next-project-section">
        <div class="container next-project-inner">
          <p class="eyebrow">A project shaped around real work</p>
          <h2>Good systems make<br /><em>hard work clearer.</em></h2>
          <div><a class="button button-primary" href={`${base}#contact`}>Start a conversation <span aria-hidden="true">↗</span></a><a class="text-link light-link" href={`${base}#work`}>Back to selected work <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
    </main>

    <footer class="site-footer container"><span>© {new Date().getFullYear()} Jerusa Mae Abalos</span><span>AIMS · Project preview</span><a href={`${base}`}>Back to home ↑</a></footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;1,500;1,600&display=swap');
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; color: #18201e; background: #f7f8fb; font-family: 'DM Sans', sans-serif; }
  :global(a) { color: inherit; text-decoration: none; }
  .container { width: min(1120px, calc(100% - 64px)); margin: 0 auto; }
  .site-header { width: min(1120px, calc(100% - 64px)); height: 88px; margin: auto; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #dfe4e3; }
  .brand { font-size: 1.15rem; font-weight: 700; letter-spacing: .12em; }.brand span { color: #e66b4d; }.back-link, .header-link { color: #697471; font-size: .78rem; }.back-link:hover, .header-link:hover, .text-link:hover { color: #e66b4d; }.header-link { color: #384340; font-weight: 600; }.header-link span { margin-left: 8px; color: #e66b4d; }
  .project-hero { padding: 115px 0 105px; }.eyebrow, .section-label, .project-meta span, .subsystem-grid span, .capability-list article > strong { font-family: 'DM Mono', monospace; text-transform: uppercase; letter-spacing: .12em; font-size: .68rem; }.eyebrow { display: flex; align-items: center; gap: 9px; color: #6f7977; }.status-dot { width: 7px; height: 7px; display: inline-block; border-radius: 100%; background: #e66b4d; box-shadow: 0 0 0 5px #fbe8e1; }
  h1, h2, h3, p { margin-top: 0; } h1 { max-width: 950px; margin: 28px 0; font-size: clamp(3.5rem, 8vw, 7rem); line-height: .95; letter-spacing: -.07em; font-weight: 600; } h1 em, h2 em { color: #e66b4d; font-family: 'Playfair Display', serif; font-weight: 500; letter-spacing: -.04em; } h2 { font-size: clamp(2.5rem, 5vw, 4.3rem); line-height: 1.02; letter-spacing: -.06em; font-weight: 600; } h3 { font-size: 1.4rem; line-height: 1.1; letter-spacing: -.04em; }
  .hero-intro { max-width: 700px; color: #697471; font-size: 1.1rem; line-height: 1.75; }.project-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 25px; max-width: 780px; margin-top: 62px; padding-top: 25px; border-top: 1px solid #dfe4e3; }.project-meta div { display: flex; flex-direction: column; gap: 10px; }.project-meta span { color: #e66b4d; }.project-meta strong { color: #384340; font-size: .86rem; }
  .preview-section { padding: 70px 0 110px; background: #eef2f0; }.preview-frame { overflow: hidden; border: 1px solid #d6dfdb; background: #fff; box-shadow: 0 22px 55px rgba(24, 32, 30, .12); }.preview-frame img { display: block; width: 100%; height: auto; }.image-caption { max-width: 720px; margin: 22px 0 0; color: #7a8581; font-size: .8rem; line-height: 1.6; }
  .section { padding: 145px 0; }.overview-grid, .architecture-grid { display: grid; grid-template-columns: 180px 1fr; gap: 90px; }.section-label { display: flex; gap: 20px; color: #88928e; }.section-label span:first-child { color: #e66b4d; }.overview-content { max-width: 730px; }.overview-content h2, .architecture-grid h2 { margin-top: 0; }.large-copy { color: #3e4c48; font-size: 1.27rem; line-height: 1.65; }.overview-content > p:not(.large-copy) { max-width: 650px; color: #7a8581; font-size: .95rem; line-height: 1.8; }
  .section-tint { background: #eef2f0; }.capability-list { margin-top: 55px; border-top: 1px solid #cdd6d2; }.capability-list article { display: grid; grid-template-columns: 55px 1fr; gap: 20px; padding: 32px 0; border-bottom: 1px solid #cdd6d2; }.capability-list article > strong { color: #e66b4d; }.capability-list h3 { margin: 0 0 12px; }.capability-list p { max-width: 650px; margin: 0; color: #687570; font-size: .92rem; line-height: 1.7; }
  .section-heading { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 66px; }.section-heading > p { color: #7b8582; font-size: .9rem; }.subsystem-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid #dfe4e3; }.subsystem-grid div { display: flex; align-items: center; gap: 22px; padding: 23px 0; border-bottom: 1px solid #dfe4e3; }.subsystem-grid div:nth-child(odd) { margin-right: 35px; }.subsystem-grid span { color: #e66b4d; }.subsystem-grid strong { font-size: .92rem; font-weight: 500; }
  .next-project-section { color: #f7f8fb; background: #1c2825; }.next-project-inner { padding: 120px 0; }.next-project-inner .eyebrow { color: #aebbb5; }.next-project-inner h2 { margin: 22px 0 40px; }.next-project-inner h2 em { color: #e66b4d; }.button { display: inline-flex; align-items: center; gap: 20px; padding: 15px 20px; border: 1px solid transparent; font-size: .78rem; font-weight: 700; }.button-primary { color: #fff; background: #e66b4d; }.button-primary:hover { background: #f7f8fb; color: #18201e; }.text-link { color: #697471; font-size: .8rem; }.text-link span { margin-left: 9px; color: #e66b4d; }.light-link { margin-left: 28px; color: #aebbb5; }.site-footer { display: flex; justify-content: space-between; gap: 20px; padding: 28px 0; color: #8b9692; font-family: 'DM Mono', monospace; font-size: .62rem; text-transform: uppercase; letter-spacing: .06em; }
  @media (max-width: 720px) { .container, .site-header { width: min(100% - 40px, 1120px); }.site-header { height: 70px; }.back-link { display: none; }.header-link { font-size: .7rem; }.project-hero { padding: 90px 0 80px; } h1 { font-size: clamp(3.2rem, 15vw, 5.5rem); }.project-meta { grid-template-columns: 1fr; gap: 20px; margin-top: 45px; }.preview-section { padding: 45px 0 80px; }.section { padding: 90px 0; }.overview-grid, .architecture-grid { display: block; }.section-label { margin-bottom: 55px; }.overview-content h2, .architecture-grid h2 { margin-bottom: 35px; }.section-heading { display: block; margin-bottom: 42px; }.section-heading > p { margin-top: 25px; }.subsystem-grid { grid-template-columns: 1fr; }.subsystem-grid div:nth-child(odd) { margin-right: 0; }.next-project-inner { padding: 90px 0; }.light-link { display: inline-block; margin: 22px 0 0; }.site-footer { align-items: flex-start; flex-direction: column; line-height: 1.6; } }
</style>
